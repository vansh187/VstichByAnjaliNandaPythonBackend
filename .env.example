# Copy to .env and fill in real values. This file is documentation only -
# it is never loaded by the app itself.

# --- Customer JWT auth ------------------------------------------------------
JWT_SECRET=                                  # HMAC signing secret for customer access tokens
JWT_ALGORITHM=HS256                          # jose algorithm for customer tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60           # customer token lifetime, in minutes

# --- Admin JWT auth ----------------------------------------------------------
ADMIN_JWT_SECRET=                            # HMAC signing secret for admin access tokens - must differ from JWT_SECRET
ADMIN_JWT_ALGORITHM=HS256                    # jose algorithm for admin tokens
ADMIN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60     # admin token lifetime, in minutes

# --- Database ----------------------------------------------------------------
DATABASE_URL=                                # Postgres/Supabase connection string (sslmode=require is enforced by the app if omitted here)

# --- Google OAuth login ------------------------------------------------------
GOOGLE_CLIENT_ID=                            # OAuth client id - the audience the backend verifies Google ID tokens against

# --- Razorpay (customer checkout) --------------------------------------------
RAZORPAY_API_KEY=                            # Razorpay key id
RAZORPAY_SECRET_KEY=                         # Razorpay key secret
RAZORPAY_WEBHOOK_SECRET=                     # HMAC secret Razorpay signs webhook payloads with

# --- Shiprocket (shipping) ----------------------------------------------------
VSTITCH_SHIPMENT_EMAIL=                      # Shiprocket account email used to obtain an API token
VSTITCH_SHIPMENT_PASSWORD=                   # Shiprocket account password
SHIPROCKET_PICKUP_LOCATION=                  # Pickup location name configured in Shiprocket
SHIPROCKET_PICKUP_POSTCODE=                  # Pickup location postcode
SHIPROCKET_WEBHOOK_API_KEY=                  # Shared secret Shiprocket's tracking webhook must present as x-api-key

# --- Internal ops ------------------------------------------------------------
INTERNAL_OPS_API_KEY=                        # Shared key gating internal-ops-only endpoints (compared with hmac.compare_digest)

# --- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=                             # Comma-separated list of allowed frontend origins, e.g. https://vstitch.example.com,https://admin.vstitch.example.com
                                              # Falls back to http://localhost:5173,http://localhost:3000 if unset (local dev only - set a real value in production)
